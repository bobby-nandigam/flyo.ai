# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
ENVIRONMENT=development
DEBUG=true
DEFAULT_CURRENCY=INR

# --- Security (generate a strong value for anything non-local) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Data stores ---
DATABASE_URL=postgresql+psycopg://flyo:flyo@localhost:5432/flyo
REDIS_URL=redis://localhost:6379/0

# --- AI investigation agent (optional) ---
# Leave AI_ENABLED=false to run the platform fully on synthetic data with the
# simulated investigation agent and no external API calls or costs.
AI_ENABLED=false
OPENAI_API_KEY=
